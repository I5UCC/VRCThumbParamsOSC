<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>../icon.ico</ApplicationIcon>
    <AssemblyName>ThumbParamsOSC</AssemblyName>
    <RootNamespace>ThumbParamsOSC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy the default config to the output directory so the app can find it on first run -->
    <Content Include="../config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>config.json</Link>
    </Content>
    <!-- Embed the default config so the app can create it programmatically if it is missing -->
    <EmbeddedResource Include="../config.json">
      <LogicalName>config.json</LogicalName>
    </EmbeddedResource>
    <!-- Copy the OpenVR native DLL to the output directory (copyToOutput is false in the package's contentFiles) -->
    <Content Include="$(PkgOpenVR_NET)/content/openvr_api.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>openvr_api.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenVR.NET" Version="0.8.5" GeneratePathProperty="true" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <!-- Override the vulnerable transitive SixLabors.ImageSharp dependency with a patched version -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
  </ItemGroup>

</Project>